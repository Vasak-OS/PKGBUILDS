_pkgname="calamares"
pkgname="vasakos-$_pkgname"
pkgver=3.4.2
pkgrel=2
pkgdesc="Distribution-independent installer framework"
url="https://codeberg.org/Calamares/calamares"
license=("GPL-3.0-or-later")
arch=('i686' 'x86_64')

depends=(
  'kcoreaddons'
  'kpmcore'
  'kcrash'
  'libpwquality'
  'qt6-declarative'
  'qt6-svg'
  'yaml-cpp'
)
makedepends=(
  'extra-cmake-modules'
  'libglvnd'
  'ninja'
  'qt6-tools'
  'qt6-translations'
)

_pkgsrc="$_pkgname"
_pkgext="tar.gz"
source=("$_pkgname-$pkgver.$_pkgext"::"$url/archive/v$pkgver.$_pkgext")
sha256sums=('7b8d0ee09645ad9d625baaebe0ba9ffd5baedbe92153347fd4d0a003a2d7639c')

build() {
  # Los flags se fijan acá y no se hereda makepkg.conf, por lo mismo que en los
  # paquetes Rust: la configuración de la máquina que compila no es confiable.
  # En este equipo CFLAGS/CXXFLAGS están comentados, y la línea comentada que
  # ofrece CachyOS trae `-march=native -O3`: descomentarla produciría un
  # instalador que muere con «instrucción ilegal» en cualquier CPU más vieja.
  #
  # `-march=x86-64 -mtune=generic` es la línea base de x86-64: corre en todo
  # procesador de 64 bits. La optimización no entra acá — CMAKE_BUILD_TYPE=Release
  # ya agrega su propio `-O3 -DNDEBUG` después de estos flags.
  #
  # Lo que sí faltaba es el endurecimiento que Arch pone por defecto y que sin
  # CFLAGS no llega. `-fstack-protector-strong` y `-fcf-protection` ya vienen
  # activados en el GCC de Arch; _FORTIFY_SOURCE y BIND_NOW no. Importa más que
  # en otros paquetes: esto corre como root durante la instalación.
  local _hardening=(
    -march=x86-64 -mtune=generic
    -pipe -fno-plt -fexceptions
    -Wp,-U_FORTIFY_SOURCE -Wp,-D_FORTIFY_SOURCE=3
    -Wformat -Werror=format-security
    -fstack-clash-protection -fcf-protection
  )
  export CFLAGS="${_hardening[*]}"
  export CXXFLAGS="${_hardening[*]} -Wp,-D_GLIBCXX_ASSERTIONS"
  export LDFLAGS="-Wl,-O1 -Wl,--sort-common -Wl,--as-needed -Wl,-z,relro -Wl,-z,now -Wl,-z,pack-relative-relocs"

  local _skip_modules=(
    dracut
    dracutlukscfg
    dummycpp
    dummyprocess
    dummypython
    dummypythonqt
    initramfs
    initramfscfg
    interactiveterminal
    packagechooser
    packagechooserq
    services-openrc
  )

  local _cmake_options=(
    -B build
    -S "$_pkgsrc"
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX='/usr'
    -DCMAKE_INSTALL_LIBDIR='lib'
    -DWITH_QT6=ON
    -DINSTALL_CONFIG=ON
    -DSKIP_MODULES="${_skip_modules[*]}"
    -DBUILD_TESTING=OFF
    -Wno-dev
  )

  cmake "${_cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}