# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-calendar
pkgver=0.6.6
pkgrel=1
pkgdesc="Calendar for VasakOS: the events of your connected accounts, month by month."
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPLv3')
depends=(
    'cairo'
    'dbus'
    'desktop-file-utils'
    'gdk-pixbuf2'
    'glib2'
    'gtk3'
    'hicolor-icon-theme'
    'libsoup3'
    'webkit2gtk-4.1'
    # La zona horaria y sus cambios salen de org.freedesktop.timedate1, que
    # trae systemd. Sin él, donde ni TZ ni /etc/localtime alcancen, el
    # calendario cae a UTC y no se entera de un cambio de zona.
    'systemd'
    # El servicio que guarda las cuentas. Sin él no hay ningún calendario que
    # mostrar: la aplicación abre igual y lo dice, pero un calendario que nunca
    # puede tener eventos no es un paquete que valga la pena instalar solo.
    #
    # No hace falta nada más para hablar CalDAV. El TLS es rustls, que va
    # compilado adentro: no hay un openssl del sistema en el binario. Verificado
    # con readelf sobre el resultado, no con ldd.
    'vasak-accounts'
)

makedepends=(
    'git'
    'openssl'
    'appmenu-gtk-module'
    'libappindicator-gtk3'
    'librsvg'
    'cargo'
    'bun'
    'rust'
    'lld'
)
install="vasak-calendar.install"
source=("git+${url}.git")
sha256sums=('SKIP')

# makepkg inyecta -flto global en CFLAGS/LDFLAGS, y los crates que compilan C o
# assembly —ring, vía rustls— emiten bitcode que el enlazador de rustc no
# resuelve. Cargo ya hace su propio LTO en el perfil de release, así que el de
# makepkg es redundante además de dañino.
options=('!lto')

prepare() {
    cd "$srcdir/$pkgname"
    bun install
}

build() {
    cd "$srcdir/$pkgname"
    unset CFLAGS
    unset CXXFLAGS
    unset CPPFLAGS
    unset LDFLAGS
    # Un paquete no se compila para la máquina que le tocó compilarlo.
    #
    # makepkg exporta RUSTFLAGS desde makepkg.conf, y acá rust.conf pone
    # `-C target-cpu=native`: eso compila para el CPU que está construyendo, y el
    # resultado muere con SIGILL en cualquiera más viejo. `x86-64` es la línea de
    # base que todas las máquinas de 64 bits implementan.
    #
    # CARGO_ENCODED_RUSTFLAGS le gana a RUSTFLAGS en la precedencia de cargo, así
    # que tiene que irse o poner RUSTFLAGS acá se ignoraría en silencio.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    # `-- --locked` le pasa la bandera a cargo, que es el runner de `tauri
    # build`. Sin ella, un candado desfasado se resuelve solo y en silencio en
    # vez de cortar la compilación: dos builds del mismo commit pueden dar
    # binarios distintos y nada lo dice.
    bun run tauri build -- --locked
}

package() {
    # El directorio del bundle lleva la versión de tauri.conf.json, no la de este
    # archivo. Cuando las dos se separan, la copia falla con `cp: cannot stat`
    # nombrando una ruta en lugar del problema — y una compilación que llegó
    # hasta acá ya gastó varios minutos.
    local built
    built=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$srcdir/$pkgname/src-tauri/tauri.conf.json" | head -1)
    if [ -n "$built" ] && [ "$built" != "$pkgver" ]; then
        error "pkgver=$pkgver pero la aplicación se construyó como $built."
        error "Actualizá pkgver en este PKGBUILD para que coincida."
        return 1
    fi

    cp -a "$srcdir/$pkgname/src-tauri/target/release/bundle/deb/${pkgname}_${pkgver}_"*/data/* "${pkgdir}"

    # El plugin de i18n resuelve los catálogos en tiempo de ejecución y sólo prueba
    # rutas relativas al ejecutable y al directorio de trabajo, así que un paquete
    # instalado no encuentra nada si no van donde lib.rs los busca.
    install -dm755 "${pkgdir}/usr/share/${pkgname}/locales"
    install -Dm644 "$srcdir/$pkgname/src-tauri/locales/"*.yml \
        "${pkgdir}/usr/share/${pkgname}/locales/"
}

pkgver() {
    # La versión es la que declara el proyecto —el `package.json` de la raíz—, no un número
    # escrito acá que alguien tiene que acordarse de bumpar.
    #
    # Sin esto la deriva era invisible: `vasak-accounts` iba cuatro versiones
    # atrás en su receta y nada lo señalaba. `makpkg` no tiene contra qué
    # comparar, y un paquete con la versión vieja se publica, se instala y
    # anda. Lo único que lo delata es ir a mirarlo.
    #
    # **Sin sufijo `.rN.gHASH`**, a diferencia de los otros `-git` de este
    # repo. El sufijo del nombre del directorio está para marcar *procedencia*
    # —que el paquete sale del repo y no de los `.deb` ya compilados de los
    # releases—, no para adoptar la convención de versions de VCS.
    #
    # La consecuencia, para que no se descubra por sorpresa: si el upstream
    # hace commit sin cambiar su versión, este `pkgver` no se mueve y
    # `build-all.sh` va a decir que el paquete está al día. El escape ya está
    # documentado en `build-all.sh` (línea 29): **nombrar el directorio fuerza
    # el rebuild**.
    cd "$srcdir/$pkgname" || return 1
    # shellcheck source=../lib/versiones.sh
    # `$startdir` es el directorio de la receta, y `makpkg` lo define siempre.
    # Con la ruta relativa a secas dependería del directorio de trabajo.
    source "$startdir/../lib/versiones.sh"
    version_de_arbol "$srcdir/$pkgname"
}
