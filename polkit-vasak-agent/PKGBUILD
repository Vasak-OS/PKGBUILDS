# Maintainer: Joaquin (Pato) Decima <pato@vasak.net.ar>

pkgname=polkit-vasak-agent
pkgver=0.2.0
pkgrel=1
pkgdesc="Agente de autenticación PolicyKit para VasakOS"
arch=('x86_64')
url="https://github.com/Vasak-OS/polkit-vasak"
license=('GPL3')
depends=(
    'dbus'
    'polkit'
    'glibc'
    'gcc-libs'
    'desktop-file-utils'
    'hicolor-icon-theme'
    'pam'
)
makedepends=(
    'git'
    'openssl'
    'librsvg'
    'cargo'
    'bun'
    'rust'
    'webkit2gtk-4.1'
    'gtk3'
)
source=("${pkgname}::git+${url}.git"
        "polkit-vasak-agent.service")
sha256sums=('SKIP'
            '4e0e18afb5d784a5a8426e781cea588f1efc62c7ac0e0b32a6503884c4f391fd')
install="polkit-vasak-agent.install"

# makepkg's global LTO injects -flto into CFLAGS/LDFLAGS. Crates that build C or
# assembly (ring, via rustls) then emit LTO bitcode that rustc's linker cannot
# resolve, failing with undefined ring_core_* symbols. Rust does its own LTO via
# the Cargo release profile, so makepkg's is redundant here as well as harmful.
options=('!lto')

prepare() {
    cd "$srcdir/$pkgname"
    bun install
}

build() {
    cd "$srcdir/$pkgname"
    unset CFLAGS
    unset CXXFLAGS
    unset CPPFLAGS
    unset LDFLAGS
    # A package is not built for the machine that happens to compile it.
    #
    # makepkg exports RUSTFLAGS from makepkg.conf, and on this build host
    # /etc/makepkg.conf.d/rust.conf sets `-C target-cpu=native`. That compiles
    # for whatever CPU is doing the build: the result works there and dies with
    # SIGILL everywhere older. Built on any Haswell-or-newer machine it emits
    # AVX2 and BMI2 instructions, which no x86-64 from before 2013 has.
    #
    # `x86-64` is the baseline every 64-bit machine implements. Nothing else is
    # given up: opt-level, LTO and codegen-units do not depend on the CPU model
    # and stay exactly as the project's Cargo.toml sets them.
    #
    # CARGO_ENCODED_RUSTFLAGS outranks RUSTFLAGS in cargo's precedence, so it
    # has to go or setting RUSTFLAGS here would be silently ignored.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    bun run tauri build
    cargo build --release --manifest-path src-tauri/Cargo.toml \
        --bin polkit-agent-helper-dbus
}

package() {
    cp -a "$srcdir/$pkgname/src-tauri/target/release/bundle/deb/vasak-polkit-agent_${pkgver}_"*/data/* "${pkgdir}"
    install -Dm755 "$srcdir/$pkgname/src-tauri/target/release/polkit-agent-helper-dbus" \
        "${pkgdir}/usr/bin/polkit-agent-helper-dbus"
    # Intentional setuid root: polkitd only accepts AuthenticationAgentResponse3
    # from uid 0 (same as the stock polkit-agent-helper-1). The helper itself
    # performs the PAM check for the requested identity before responding.
    chmod u+s "${pkgdir}/usr/bin/polkit-agent-helper-dbus"
    install -Dm644 "$srcdir/polkit-vasak-agent.service" \
        "${pkgdir}/usr/lib/systemd/user/polkit-vasak-agent.service"

    # El plugin de i18n resuelve los catálogos en tiempo de ejecución y sólo
    # prueba rutas relativas al ejecutable, así que un paquete instalado no
    # encuentra nada si no van donde `locales.rs` los busca. Sin esto el diálogo
    # que pide la contraseña sale con las claves crudas.
    install -dm755 "${pkgdir}/usr/share/vasak-polkit-agent/locales"
    install -Dm644 "$srcdir/$pkgname/src-tauri/locales/"*.yml \
        "${pkgdir}/usr/share/vasak-polkit-agent/locales/"
}
