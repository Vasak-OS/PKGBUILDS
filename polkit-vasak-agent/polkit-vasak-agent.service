[Unit]
Description=VasakOS PolicyKit Authentication Agent
Documentation=https://github.com/Vasak-OS/polkit-vasak
Requires=dbus.socket
After=dbus.socket

[Service]
PassEnvironment=XDG_SESSION_ID
Type=simple
ExecStart=/usr/bin/vasak-polkit-agent
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
