[Unit]
Description=VasakOS PolicyKit Authentication Agent
Documentation=https://github.com/Vasak-OS/polkit-vasak
# Graphical-session daemon: it must show a Wayland dialog, so it is bound to the
# graphical session (started by uwsm), NOT default.target — which is reached
# before the compositor exists and also in non-graphical (e.g. SSH) logins.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vasak-polkit-agent
Restart=on-failure
RestartSec=3

# Por acá pasa tu contraseña de administrador: es el diálogo que aparece cada
# vez que algo pide permiso para tocar el sistema. Corría sin una sola
# restricción.
#
# Sin red, que en un proceso al que le escribís la contraseña es lo primero: lo
# que tipeás ahí no tiene por dónde irse. Con polkit se habla por el bus del
# sistema, que es un socket local.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectSystem=full

# De todo /dev ve la placa de video, para dibujar el diálogo, y nada más: ni el
# teclado en crudo, ni la cámara, ni los discos. Va con PrivateDevices +
# BindPaths y no con DeviceAllow porque —comprobado— ese filtro no se aplica en
# unidades de usuario y habría quedado de adorno.
PrivateDevices=yes
BindPaths=-/dev/dri

# Quedan afuera MemoryDenyWriteExecute y RestrictNamespaces: el diálogo es una
# ventana Tauri, y WebKit compila su JavaScript en memoria y usa espacios de
# nombres para su propio aislamiento.

[Install]
WantedBy=graphical-session.target
