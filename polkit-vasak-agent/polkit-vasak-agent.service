[Unit]
Description=VasakOS PolicyKit Authentication Agent
Documentation=https://github.com/Vasak-OS/polkit-vasak
# Graphical-session daemon: it must show a Wayland dialog, so it is bound to the
# graphical session (started by uwsm), NOT default.target — which is reached
# before the compositor exists and also in non-graphical (e.g. SSH) logins.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vasak-polkit-agent
Restart=on-failure
RestartSec=3

# ⚠ Esta unidad va SIN endurecer, y no es un olvido: se intentó y dejó al
# sistema sin poder autenticar nada.
#
# Para validar la contraseña, este agente ejecuta un helper **setuid**
# (/usr/bin/polkit-agent-helper-dbus), que es como polkit consigue leer las
# credenciales del sistema desde un proceso del usuario. `NoNewPrivileges=yes`
# impide esa transición: el helper arranca como el usuario común, ve que no es
# root y responde «setuid bit missing» —culpando al archivo, que sí tiene el
# bit—. El resultado es una contraseña correcta rechazada, sin ninguna pista de
# por qué.
#
# Y no alcanza con no escribir `NoNewPrivileges`: en una unidad de usuario lo
# implican solas casi todas las de seccomp —SystemCallFilter, PrivateDevices
# (que instala un filtro para @raw-io), RestrictAddressFamilies,
# MemoryDenyWriteExecute, LockPersonality, RestrictRealtime, RestrictSUIDSGID—.
# Un `CapabilityBoundingSet=` vacío rompe lo mismo por otro camino, quitándole
# al helper las capacidades que acaba de ganar.
#
# Es el mismo choque que dejó a vasak-idle sin endurecer, y por la misma razón
# de fondo: un proceso cuyo trabajo es escalar privilegios no puede correr en
# una caja que se los prohíbe. Entre las dos cosas gana poder autenticarse.

[Install]
WantedBy=graphical-session.target
