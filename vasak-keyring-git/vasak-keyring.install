PAM_FILE=/etc/pam.d/system-login
PAM_BACKUP=/etc/pam.d/system-login.vasak-bak

# Adds the two lines the keyring needs to unlock itself at login.
#
# Editing /etc/pam.d from a package is not done lightly: a broken file there
# locks everyone out of the machine. What makes it defensible here is that every
# step is checked and the write is atomic — the new content is built in full,
# compared against the original, and only then renamed over it, so there is no
# instant where the file is half written. If anything is not exactly as expected
# the file is left alone and the instructions are printed instead.
#
# The lines are `optional`, so even a failing module cannot keep anyone from
# logging in. What could is a malformed file, and that is what the checks below
# are about.
configure_pam() {
    if [ ! -f "$PAM_FILE" ]; then
        return 1
    fi

    # Las anclas: cada línea va después de su `include system-auth`, cuando la
    # contraseña ya se pidió (auth) o ya se cambió (password); sin esos includes
    # no hay dónde anclar y el archivo no es el que esperamos. La de `session`
    # va al final (ver abajo), así que no necesita ancla propia.
    grep -Eq '^[[:space:]]*auth[[:space:]]+include[[:space:]]+system-auth' "$PAM_FILE" || return 1
    grep -Eq '^[[:space:]]*password[[:space:]]+include[[:space:]]+system-auth' "$PAM_FILE" || return 1
    grep -Eq '^[[:space:]]*session[[:space:]]+include[[:space:]]+system-auth' "$PAM_FILE" || return 1

    # Ya están las tres: nada que hacer. Es por línea y no «hay alguna», porque
    # una instalación anterior dejó sólo `auth` y `session` (sin `password`,
    # vasak-keyring#38), y al actualizar hay que agregar la que falta.
    if [ "$(grep -c pam_vasak_keyring "$PAM_FILE")" -eq 3 ]; then
        return 0
    fi

    local tmp
    tmp=$(mktemp "$PAM_FILE.vasak-XXXXXX") || return 1

    # Se parte de las líneas SIN pam_vasak_keyring —así da igual que haya 0, 2 o
    # 3 de una instalación anterior— y se insertan las tres en su ancla:
    #  - `auth`, después de su include: para entonces la contraseña ya se escribió;
    #  - `password`, después de su include: para entonces ya cambió, y se re-cifra
    #    la base con la nueva (vasak-keyring#38);
    #  - `session`, al final, después de pam_systemd: ese módulo crea
    #    /run/user/<uid>, donde vive el socket del demonio. Antes de él no hay
    #    dónde entregar la contraseña.
    grep -v pam_vasak_keyring "$PAM_FILE" | awk '
        { print }
        /^[[:space:]]*auth[[:space:]]+include[[:space:]]+system-auth/ && !a {
            print "auth       optional   pam_vasak_keyring.so"; a = 1
        }
        /^[[:space:]]*password[[:space:]]+include[[:space:]]+system-auth/ && !p {
            print "password   optional   pam_vasak_keyring.so"; p = 1
        }
        END { print "session    optional   pam_vasak_keyring.so" }
    ' > "$tmp" || { rm -f "$tmp"; return 1; }

    # Tres líneas y nada más tocado: tiene que haber exactamente tres, y lo que
    # no es pam_vasak_keyring tiene que quedar idéntico a las líneas sin
    # pam_vasak_keyring del original —así la comprobación vale tanto para una
    # instalación limpia como para una que ya tenía dos—.
    if [ "$(grep -c pam_vasak_keyring "$tmp")" -ne 3 ] ||
       ! diff <(grep -v pam_vasak_keyring "$tmp") <(grep -v pam_vasak_keyring "$PAM_FILE") > /dev/null; then
        rm -f "$tmp"
        return 1
    fi

    cp -a "$PAM_FILE" "$PAM_BACKUP" 2>/dev/null
    chmod 644 "$tmp"
    chown root:root "$tmp" 2>/dev/null
    # Rename, not copy: a partially written /etc/pam.d/system-login is the one
    # thing that could actually lock somebody out.
    mv -f "$tmp" "$PAM_FILE" || { rm -f "$tmp"; return 1; }

    echo ">>> vasak-keyring: auto-desbloqueo y re-cifrado configurados en $PAM_FILE"
    echo "    (copia del archivo anterior en $PAM_BACKUP)"
    return 0
}

# Takes the two lines back out, so an uninstalled module is not left named in
# the login stack. Same care as putting them in.
deconfigure_pam() {
    [ -f "$PAM_FILE" ] || return 0
    grep -q pam_vasak_keyring "$PAM_FILE" || return 0

    local tmp
    tmp=$(mktemp "$PAM_FILE.vasak-XXXXXX") || return 1

    grep -v pam_vasak_keyring "$PAM_FILE" > "$tmp" || { rm -f "$tmp"; return 1; }

    # Never leave an empty or obviously broken file behind.
    if ! grep -Eq '^[[:space:]]*auth[[:space:]]+include[[:space:]]+system-auth' "$tmp"; then
        rm -f "$tmp"
        return 1
    fi

    chmod 644 "$tmp"
    chown root:root "$tmp" 2>/dev/null
    mv -f "$tmp" "$PAM_FILE" || { rm -f "$tmp"; return 1; }
}

post_install() {
    mkdir -p /etc/systemd/user/default.target.wants
    ln -sf /usr/lib/systemd/user/vasak-keyring.service \
        /etc/systemd/user/default.target.wants/vasak-keyring.service

    if ! configure_pam; then
        cat <<'EOF'

>>> vasak-keyring: falta el auto-desbloqueo por PAM.

    No se pudo configurar solo porque /etc/pam.d/system-login no es el que
    esperábamos, así que no se tocó. El demonio va a arrancar, pero el
    llavero queda bloqueado y las aplicaciones no van a poder guardar ni
    leer contraseñas.

    Agregá estas tres líneas a mano:

        auth       optional   pam_vasak_keyring.so     (después del "auth include system-auth")
        password   optional   pam_vasak_keyring.so     (después del "password include system-auth")
        session    optional   pam_vasak_keyring.so     (al final del archivo, después de pam_systemd)

    `auth` toma la contraseña recién escrita, `session` se la entrega al
    demonio, y `password` re-cifra la base al cambiar la contraseña.

    Detalle en /usr/share/doc/vasak-keyring/pam/README.md

EOF
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    deconfigure_pam
}

post_remove() {
    rm -f /etc/systemd/user/default.target.wants/vasak-keyring.service
}
