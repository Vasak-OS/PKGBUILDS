# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-keyring
pkgver=0.5.0
pkgrel=1
pkgdesc="Native Secret Service keyring (AES-256-GCM/Argon2id) with PAM auto-unlock for VasakOS"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPL3')
# webkit2gtk/gtk3 are for the unlock dialog, which is a Tauri application like
# the rest of the desktop so that it follows the system's colours, radius and
# font instead of looking like a stray GTK box.
depends=('dbus' 'pam' 'glibc' 'gcc-libs' 'webkit2gtk-4.1' 'gtk3' 'cairo' 'gdk-pixbuf2' 'glib2' 'libsoup3' 'xdg-desktop-portal')
makedepends=('git' 'cargo' 'rust' 'bun')
source=("git+${url}.git")
sha256sums=('SKIP')
install="vasak-keyring.install"

# makepkg's global LTO injects -flto into CFLAGS/LDFLAGS. Crates that build C or
# assembly (ring, via rustls) then emit LTO bitcode that rustc's linker cannot
# resolve, failing with undefined ring_core_* symbols. Rust does its own LTO via
# the Cargo release profile, so makepkg's is redundant here as well as harmful.
options=('!lto')

build() {
    cd "$srcdir/$pkgname"
    # A package is not built for the machine that happens to compile it.
    #
    # makepkg exports RUSTFLAGS from makepkg.conf, and on this build host
    # /etc/makepkg.conf.d/rust.conf sets `-C target-cpu=native`. That compiles
    # for whatever CPU is doing the build: the result works there and dies with
    # SIGILL everywhere older. Built on any Haswell-or-newer machine it emits
    # AVX2 and BMI2 instructions, which no x86-64 from before 2013 has.
    #
    # `x86-64` is the baseline every 64-bit machine implements. Nothing else is
    # given up: opt-level, LTO and codegen-units do not depend on the CPU model
    # and stay exactly as the project's Cargo.toml sets them.
    #
    # CARGO_ENCODED_RUSTFLAGS outranks RUSTFLAGS in cargo's precedence, so it
    # has to go or setting RUSTFLAGS here would be silently ignored.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    # The daemon and the PAM module are plain Rust, and they are the half that
    # has to work even if the graphical one fails to build.
    cargo build --release -p vasak-keyring -p pam-vasak-keyring

    # The dialog. `tauri build` is what produces the frontend it embeds; a bare
    # cargo build would compile it against whatever ../dist happened to hold.
    cd prompt
    bun install
    bun run tauri build
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

    # Headless daemon; enabled on default.target (see post_install) because it
    # must be up early for the PAM unlock at open_session, before the graphical
    # session exists.
    install -Dm644 "$pkgname.service" \
        "$pkgdir/usr/lib/systemd/user/$pkgname.service"

    # PAM module: cargo emits libpam_vasak_keyring.so; PAM expects the
    # pam_<name>.so form under the security dir.
    install -Dm755 "target/release/libpam_vasak_keyring.so" \
        "$pkgdir/usr/lib/security/pam_vasak_keyring.so"

    # The dialog the daemon runs when the keyring is locked and the login did
    # not unlock it. It is spawned per request and exits with the answer, so
    # nothing of it stays resident.
    install -Dm755 "target/release/vasak-keyring-prompt" \
        "$pkgdir/usr/bin/vasak-keyring-prompt"

    # El programa que ssh ejecuta cuando necesita la frase de una clave. Sale
    # del mismo `tauri build` que el diálogo —comparten la interfaz— pero el
    # empaquetador de Tauri sólo copia el binario principal, así que este va
    # aparte. Sin él, cada `git push` vuelve a pedir la frase.
    install -Dm755 "target/release/vasak-ssh-askpass" \
        "$pkgdir/usr/bin/vasak-ssh-askpass"

    # D-Bus activation, so a client that asks for org.freedesktop.secrets can
    # bring the daemon up. Without this it only worked because the systemd user
    # unit happens to be enabled.
    # El backend del portal para el secreto maestro por aplicación. El .portal es
    # cómo el portal encuentra el backend; sin él no mira acá y los secretos de
    # las aplicaciones en sandbox terminaban en una cartera de KDE.
    install -Dm644 "packaging/vasak-keyring.portal" \
        "$pkgdir/usr/share/xdg-desktop-portal/portals/vasak-keyring.portal"
    install -Dm644 "packaging/org.freedesktop.impl.portal.desktop.vasak-keyring.service" \
        "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.vasak-keyring.service"

    install -Dm644 "dbus/org.freedesktop.secrets.service" \
        "$pkgdir/usr/share/dbus-1/services/org.freedesktop.secrets.service"

    install -Dm644 "pam/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/pam/README.md"

    # The PAM lines that make the keyring unlock itself at login are added by
    # post_install, not from here: see vasak-keyring.install. It only touches
    # /etc/pam.d/system-login when the file is exactly the one it expects, checks
    # the result before writing it, and renames it into place so the file is
    # never half written. See usr/share/doc/vasak-keyring/pam/README.md.
}
