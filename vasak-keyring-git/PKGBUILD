# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-keyring
pkgver=0.2.1
pkgrel=2
pkgdesc="Native Secret Service keyring (AES-256-GCM/Argon2id) with PAM auto-unlock for VasakOS"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPL3')
depends=('dbus' 'pam' 'glibc' 'gcc-libs')
makedepends=('git' 'cargo' 'rust')
source=("git+${url}.git")
sha256sums=('SKIP')
install="vasak-keyring.install"

# makepkg's global LTO injects -flto into CFLAGS/LDFLAGS. Crates that build C or
# assembly (ring, via rustls) then emit LTO bitcode that rustc's linker cannot
# resolve, failing with undefined ring_core_* symbols. Rust does its own LTO via
# the Cargo release profile, so makepkg's is redundant here as well as harmful.
options=('!lto')

build() {
    cd "$srcdir/$pkgname"
    # A package is not built for the machine that happens to compile it.
    #
    # makepkg exports RUSTFLAGS from makepkg.conf, and on this build host
    # /etc/makepkg.conf.d/rust.conf sets `-C target-cpu=native`. That compiles
    # for whatever CPU is doing the build: the result works there and dies with
    # SIGILL everywhere older. Built on any Haswell-or-newer machine it emits
    # AVX2 and BMI2 instructions, which no x86-64 from before 2013 has.
    #
    # `x86-64` is the baseline every 64-bit machine implements. Nothing else is
    # given up: opt-level, LTO and codegen-units do not depend on the CPU model
    # and stay exactly as the project's Cargo.toml sets them.
    #
    # CARGO_ENCODED_RUSTFLAGS outranks RUSTFLAGS in cargo's precedence, so it
    # has to go or setting RUSTFLAGS here would be silently ignored.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    # Workspace: builds the daemon (vasak-keyring) and the PAM module cdylib.
    cargo build --release --workspace
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

    # Headless daemon; enabled on default.target (see post_install) because it
    # must be up early for the PAM unlock at open_session, before the graphical
    # session exists.
    install -Dm644 "$pkgname.service" \
        "$pkgdir/usr/lib/systemd/user/$pkgname.service"

    # PAM module: cargo emits libpam_vasak_keyring.so; PAM expects the
    # pam_<name>.so form under the security dir.
    install -Dm755 "target/release/libpam_vasak_keyring.so" \
        "$pkgdir/usr/lib/security/pam_vasak_keyring.so"

    # D-Bus activation, so a client that asks for org.freedesktop.secrets can
    # bring the daemon up. Without this it only worked because the systemd user
    # unit happens to be enabled.
    install -Dm644 "dbus/org.freedesktop.secrets.service" \
        "$pkgdir/usr/share/dbus-1/services/org.freedesktop.secrets.service"

    install -Dm644 "pam/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/pam/README.md"

    # NOTE: to auto-unlock the keyring at login, the login PAM stack has to load
    # the module. /etc/pam.d/system-login covers greetd and the consoles; both
    # lines go AFTER the corresponding "include system-auth":
    #
    #   auth       optional   pam_vasak_keyring.so
    #   session    optional   pam_vasak_keyring.so
    #
    # BOTH are required: `auth` captures the password the user just typed
    # (pam_get_authtok) and `session` is what hands it to the daemon. With only
    # `session` the module finds nothing stored and the keyring stays locked.
    # See usr/share/doc/vasak-keyring/pam/README.md.
    #
    # This is intentionally NOT applied automatically to avoid breaking login.
}
