# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-press-and-hold
pkgver=0.2.0
pkgrel=1
pkgdesc="Press & hold a key to pick accented characters on Wayland, for VasakOS"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPL-3.0-or-later')
depends=(
    'gtk3'
    'webkit2gtk-4.1'
    'libxkbcommon'
    'libappindicator-gtk3'
    # The picker is drawn as a layer-shell surface so it can place itself next
    # to the caret instead of wherever the compositor decides.
    'gtk-layer-shell'
    'cairo'
    'dbus'
    'gdk-pixbuf2'
    'glib2'
    'libsoup3'
)
makedepends=(
    'git'
    'openssl'
    'cargo'
    'bun'
    'rust'
)
source=("git+${url}.git")
sha256sums=('SKIP')
install="$pkgname.install"

# makepkg's global LTO injects -flto into CFLAGS/LDFLAGS. Crates that build C or
# assembly then emit LTO bitcode that rustc's linker cannot resolve. Rust does
# its own LTO via the Cargo release profile, so makepkg's is redundant here as
# well as harmful.
options=('!lto')

prepare() {
    cd "$srcdir/$pkgname"
    bun install
}

build() {
    cd "$srcdir/$pkgname"
    # A package is not built for the machine that happens to compile it.
    #
    # makepkg exports RUSTFLAGS from makepkg.conf, and on this build host
    # /etc/makepkg.conf.d/rust.conf sets `-C target-cpu=native`. That compiles
    # for whatever CPU is doing the build: the result works there and dies with
    # SIGILL everywhere older. Built on any Haswell-or-newer machine it emits
    # AVX2 and BMI2 instructions, which no x86-64 from before 2013 has.
    #
    # `x86-64` is the baseline every 64-bit machine implements. Nothing else is
    # given up: opt-level, LTO and codegen-units do not depend on the CPU model
    # and stay exactly as the project's Cargo.toml sets them.
    #
    # CARGO_ENCODED_RUSTFLAGS outranks RUSTFLAGS in cargo's precedence, so it
    # has to go or setting RUSTFLAGS here would be silently ignored.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    bun run tauri build
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

    # Reading the keyboard means reading the input devices. The rule tags them
    # with uaccess so the *active session* gets them, instead of adding the user
    # to the input group, which would grant it to every session at once and for
    # good.
    install -Dm644 "60-$pkgname.rules" \
        "$pkgdir/usr/lib/udev/rules.d/60-$pkgname.rules"

    # And uinput has to be loaded for that rule to have a device to act on: the
    # node exists from boot as a static one, with nothing behind it and no
    # uevent, which is why the rule alone left it root-only.
    install -Dm644 "packaging/$pkgname.modules-load.conf" \
        "$pkgdir/usr/lib/modules-load.d/$pkgname.conf"

    # Nothing started the daemon before: no unit, no autostart entry. The
    # feature was installed and simply never ran, which from the outside looks
    # exactly like it not working.
    install -Dm644 "packaging/$pkgname.service" \
        "$pkgdir/usr/lib/systemd/user/$pkgname.service"

    for size in 32x32 128x128 128x128@2x; do
        [[ -f "src-tauri/icons/${size}.png" ]] || continue
        install -Dm644 "src-tauri/icons/${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}/apps/$pkgname.png"
    done

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
