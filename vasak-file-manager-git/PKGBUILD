# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-file-manager
pkgver=0.26.0
pkgrel=1
pkgdesc="File manager for VasakOS"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPLv3')
depends=(
    'cairo'
    'desktop-file-utils'
    'gdk-pixbuf2'
    'glib2'
    'gtk3'
    # El backend de WebDAV de gvfs, que es con lo que se montan los discos en la
    # nube de las cuentas en línea. En Arch viene en gvfs-dnssd y no en gvfs, que
    # es la clase de cosa que se descubre cuando el montaje falla con «esquema no
    # soportado» — verificado con `pacman -F`.
    #
    # Va acá y no en el metapaquete del escritorio, aunque los otros gvfs-* estén
    # allá: es esta aplicación la que no anda sin él.
    'gvfs-dnssd'
    # Y el servicio que guarda las cuentas: sin él no hay discos que listar ni
    # credenciales con las que montarlos.
    'vasak-accounts'
    'hicolor-icon-theme'
    'libsoup3'
    # La base de datos de tipos de archivo de freedesktop, que es de donde sale
    # el icono de cada uno. Sin ella `g_content_type_guess` contesta
    # «application/octet-stream» para todo y la ventana vuelve a dibujar hojas en
    # blanco: no rompe, pero deja de servir. Llegaba de arrastre por gdk-pixbuf2;
    # ahora se usa de frente, así que se declara.
    #
    # No lleva auditoría con `readelf` porque no aporta ninguna biblioteca: son
    # los datos de /usr/share/mime —freedesktop.org.xml y la caché que arma
    # `update-mime-database`— que lee glib2, que sí está más abajo.
    'shared-mime-info'
    'webkit2gtk-4.1'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'gst-libav'
    # libzstd: el binario la enlaza (ZSTD_SYS_USE_PKG_CONFIG, más abajo), no la
    # lanza como programa.
    'zstd'
    # Los compresores que el gestor lanza para comprimir y descomprimir
    # (compress.rs y extract.rs). `7z` lo trae 7zip, que reemplazó a p7zip.
    '7zip'
    'zip'
    'unzip'
    'tar'
    'dbus'
    # `xdg-open` y `xdg-mime`: abrir con la aplicación predeterminada y saber
    # cuál es. Se lanzaban sin declararse (#105).
    'xdg-utils'
    # Con lo que se montan y desmontan las unidades. Se usaba desde siempre —el
    # montaje llamaba a `udisksctl`— y no figuraba: en un sistema sin él, hacer
    # clic en un pendrive no hacía nada. Ahora el montaje va por el bus, contra
    # el mismo servicio.
    'udisks2'
)
# `unrar` es opcional: sin él lo único que no anda es abrir los .rar, y en el
# .deb va como recomendado por estar en non-free.
#
# ffmpeg, poppler, sshfs y fuse3 también (#105): los dos primeros son pesados y
# sólo dan miniaturas —sin ellos la vista muestra el icono del tipo—, y los otros
# dos sólo le sirven a quien monta por SSH. Montar sin `sshfs` dice qué paquete
# falta. `fuse3` trae `fusermount3`, que es con lo que se desmonta; `sshfs` ya lo
# arrastra, pero se nombra porque lo lanza el gestor. `gio` viene en glib2, que
# está en depends.
#
# `wayland` salió de `depends`: el binario no enlaza libwayland-client
# (`readelf -d`), el plugin de arrastrar y soltar va por GTK sin dlopen, y el
# `wayland-client` de Rust usa su backend propio. La biblioteca se carga, pero
# como NEEDED de libgdk-3, o sea que ya la trae gtk3 (comprobado con
# LD_DEBUG=libs).
optdepends=(
    'polkit-vasak-agent: para abrir discos cifrados y autorizar el montaje de particiones internas'
    'unrar: descomprimir archivos .rar'
    'ffmpeg: miniaturas de video'
    'poppler: miniaturas y vista previa de PDF'
    'sshfs: montar carpetas por SSH'
    'fuse3: desmontar las carpetas montadas por SSH'
)
makedepends=(
    'git'
    'pkgconf'
    'openssl'
    'appmenu-gtk-module'
    'libappindicator-gtk3'
    'librsvg'
    'cargo'
    'bun'
    'rust'
    'zstd'
)
source=("git+${url}.git")
sha256sums=('SKIP')
install="vasak-file-manager.install"

# makepkg's global LTO injects -flto into CFLAGS/LDFLAGS. Crates that build C or
# assembly (ring, via rustls) then emit LTO bitcode that rustc's linker cannot
# resolve, failing with undefined ring_core_* symbols. Rust does its own LTO via
# the Cargo release profile, so makepkg's is redundant here as well as harmful.
options=('!lto')

prepare() {
    cd "$srcdir/$pkgname"
    # Instalar dependencias con bun
    bun install
}

build() {
    cd "$srcdir/$pkgname"
    # A package is not built for the machine that happens to compile it.
    #
    # makepkg exports RUSTFLAGS from makepkg.conf, and on this build host
    # /etc/makepkg.conf.d/rust.conf sets `-C target-cpu=native`. That compiles
    # for whatever CPU is doing the build: the result works there and dies with
    # SIGILL everywhere older. Built on any Haswell-or-newer machine it emits
    # AVX2 and BMI2 instructions, which no x86-64 from before 2013 has.
    #
    # `x86-64` is the baseline every 64-bit machine implements. Nothing else is
    # given up: opt-level, LTO and codegen-units do not depend on the CPU model
    # and stay exactly as the project's Cargo.toml sets them.
    #
    # CARGO_ENCODED_RUSTFLAGS outranks RUSTFLAGS in cargo's precedence, so it
    # has to go or setting RUSTFLAGS here would be silently ignored.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    export ZSTD_SYS_USE_PKG_CONFIG=1
    # `-- --locked` le pasa la bandera a cargo, que es el runner de `tauri
    # build`. Sin ella, un candado desfasado se resuelve solo y en silencio en
    # vez de cortar la compilación: dos builds del mismo commit pueden dar
    # binarios distintos y nada lo dice.
    bun run tauri build -- --locked
}

package() {
    # The bundle directory is named with the version in tauri.conf.json, not
    # with this file's pkgver. When the two drift the copy below failed with
    # `cp: cannot stat`, naming a path instead of the actual problem — and a
    # build that got that far had already spent twelve minutes compiling.
    local built
    built=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$srcdir/$pkgname/src-tauri/tauri.conf.json" | head -1)
    if [ -n "$built" ] && [ "$built" != "$pkgver" ]; then
        error "pkgver=$pkgver pero la aplicación se construyó como $built."
        error "Actualizá pkgver en este PKGBUILD para que coincida."
        return 1
    fi

    cp -a $srcdir/$pkgname/src-tauri/target/release/bundle/deb/${pkgname}_${pkgver}_*/data/* "${pkgdir}"

    # The i18n plugin resolves translations at runtime and only probes paths
    # relative to the binary and the working directory, so an installed build
    # finds nothing unless the locales are shipped where lib.rs looks for them.
    install -dm755 "${pkgdir}/usr/share/${pkgname}/locales"
    install -Dm644 "$srcdir/$pkgname/src-tauri/locales/"*.yml \
        "${pkgdir}/usr/share/${pkgname}/locales/"
}
