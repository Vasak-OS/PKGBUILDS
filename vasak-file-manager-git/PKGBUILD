# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-file-manager
pkgver=0.6.0
pkgrel=1
pkgdesc="File manager for VasakOS"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPLv3')
depends=(
    'cairo'
    'desktop-file-utils'
    'gdk-pixbuf2'
    'glib2'
    'gtk3'
    'hicolor-icon-theme'
    'libsoup3'
    'pango'
    'webkit2gtk-4.1'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'gst-libav'
    'zstd'
    'p7zip'
    'unrar'
    'zip'
    'unzip'
    'tar'
    'dbus'
    'wayland'
)
makedepends=(
    'git'
    'pkgconf'
    'openssl'
    'appmenu-gtk-module'
    'libappindicator-gtk3'
    'librsvg'
    'cargo'
    'bun'
    'rust'
    'zstd'
)
source=("git+${url}.git")
sha256sums=('SKIP')
install="vasak-file-manager.install"

# makepkg's global LTO injects -flto into CFLAGS/LDFLAGS. Crates that build C or
# assembly (ring, via rustls) then emit LTO bitcode that rustc's linker cannot
# resolve, failing with undefined ring_core_* symbols. Rust does its own LTO via
# the Cargo release profile, so makepkg's is redundant here as well as harmful.
options=('!lto')

prepare() {
    cd "$srcdir/$pkgname"
    # Instalar dependencias con bun
    bun install
}

build() {
    cd "$srcdir/$pkgname"
    # A package is not built for the machine that happens to compile it.
    #
    # makepkg exports RUSTFLAGS from makepkg.conf, and on this build host
    # /etc/makepkg.conf.d/rust.conf sets `-C target-cpu=native`. That compiles
    # for whatever CPU is doing the build: the result works there and dies with
    # SIGILL everywhere older. Built on any Haswell-or-newer machine it emits
    # AVX2 and BMI2 instructions, which no x86-64 from before 2013 has.
    #
    # `x86-64` is the baseline every 64-bit machine implements. Nothing else is
    # given up: opt-level, LTO and codegen-units do not depend on the CPU model
    # and stay exactly as the project's Cargo.toml sets them.
    #
    # CARGO_ENCODED_RUSTFLAGS outranks RUSTFLAGS in cargo's precedence, so it
    # has to go or setting RUSTFLAGS here would be silently ignored.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    export ZSTD_SYS_USE_PKG_CONFIG=1
    bun run tauri build
}

package() {
    # The bundle directory is named with the version in tauri.conf.json, not
    # with this file's pkgver. When the two drift the copy below failed with
    # `cp: cannot stat`, naming a path instead of the actual problem — and a
    # build that got that far had already spent twelve minutes compiling.
    local built
    built=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$srcdir/$pkgname/src-tauri/tauri.conf.json" | head -1)
    if [ -n "$built" ] && [ "$built" != "$pkgver" ]; then
        error "pkgver=$pkgver pero la aplicación se construyó como $built."
        error "Actualizá pkgver en este PKGBUILD para que coincida."
        return 1
    fi

    cp -a $srcdir/$pkgname/src-tauri/target/release/bundle/deb/${pkgname}_${pkgver}_*/data/* "${pkgdir}"

    # The i18n plugin resolves translations at runtime and only probes paths
    # relative to the binary and the working directory, so an installed build
    # finds nothing unless the locales are shipped where lib.rs looks for them.
    install -dm755 "${pkgdir}/usr/share/${pkgname}/locales"
    install -Dm644 "$srcdir/$pkgname/src-tauri/locales/"*.yml \
        "${pkgdir}/usr/share/${pkgname}/locales/"
}
