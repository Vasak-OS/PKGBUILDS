# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

_pkgname="ckbcomp"
pkgname="$_pkgname"
pkgver=1.248
pkgrel=1
pkgdesc="Compile a XKB keyboard description to a keymap suitable for loadkeys or kbdcontrol"
url="https://salsa.debian.org/installer-team/console-setup"
license=('GPL-2.0-or-later')
arch=('any')

makedepends=('git')

# GitLab regenerates its /-/archive/ tarballs on demand and they are not
# byte-stable, so a recorded checksum eventually stops matching through no fault
# of the source. Cloning the tag instead is reproducible and still pinned.
_pkgsrc="console-setup"
source=("$_pkgsrc::git+$url.git#tag=$pkgver")
sha256sums=('SKIP')

package() {
  depends+=('perl')

  cd "$_pkgsrc"
  install -Dm755 Keyboard/ckbcomp -t "$pkgdir/usr/bin/"
}