# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-mail
pkgver=0.5.0
pkgrel=1
pkgdesc="Mail client for VasakOS: read the mail of your connected accounts."
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPLv3')
depends=(
    'cairo'
    'dbus'
    'desktop-file-utils'
    'gdk-pixbuf2'
    'glib2'
    'gtk3'
    'hicolor-icon-theme'
    'libsoup3'
    'pango'
    'webkit2gtk-4.1'
    # De acá sale todo el correo. La aplicación **no habla IMAP**: le pide la
    # lista y el texto a vasak-accounts-sync, que viene en este paquete y es
    # quien tiene la conexión, la credencial y el parser de MIME.
    #
    # O sea que no es una dependencia de conveniencia: sin el servicio esta
    # ventana no tiene de dónde sacar un solo mensaje. Abre igual y lo dice.
    #
    # No hace falta nada más. Ni siquiera TLS: el que habla con el servidor es el
    # otro proceso. Verificado con readelf sobre el binario, no con ldd.
    #
    # El piso de versión es el contrato de D-Bus, y se sube cada vez que cambia.
    #
    #   0.4.0  `ListMessages`, `GetMessage` y `MarkRead` reciben la casilla —los
    #          UID son por casilla, así que sin ella se pide cualquiera—.
    #   0.5.0  `GetMessage` devuelve la lista de adjuntos donde antes había un
    #          booleano.
    #
    # Desde 0.6.0 el servicio avisa por sí mismo cuando llega correo, así que la
    # ventana ya no es la única forma de enterarse. No cambia ninguna firma —el
    # piso sigue en 0.5.0— pero sin esa versión el aviso con la ventana cerrada
    # no existe.
    #
    # Sin el piso, una ventana nueva contra un servicio viejo llama con un
    # argumento de más —o lee una lista donde hay un booleano— y lo que se ve es
    # un error en lugar del correo, sin nada que diga que lo que falta es
    # actualizar el otro paquete.
    'vasak-accounts>=0.5.0'
)

makedepends=(
    'git'
    'openssl'
    'appmenu-gtk-module'
    'libappindicator-gtk3'
    'librsvg'
    'cargo'
    'bun'
    'rust'
    'lld'
)
install="vasak-mail.install"
source=("git+${url}.git")
sha256sums=('SKIP')

# makepkg inyecta -flto global en CFLAGS/LDFLAGS, y los crates que compilan C o
# assembly —ring, vía rustls— emiten bitcode que el enlazador de rustc no
# resuelve. Cargo ya hace su propio LTO en el perfil de release, así que el de
# makepkg es redundante además de dañino.
options=('!lto')

prepare() {
    cd "$srcdir/$pkgname"
    bun install
}

build() {
    cd "$srcdir/$pkgname"
    unset CFLAGS
    unset CXXFLAGS
    unset CPPFLAGS
    unset LDFLAGS
    # Un paquete no se compila para la máquina que le tocó compilarlo.
    #
    # makepkg exporta RUSTFLAGS desde makepkg.conf, y acá rust.conf pone
    # `-C target-cpu=native`: eso compila para el CPU que está construyendo, y el
    # resultado muere con SIGILL en cualquiera más viejo. `x86-64` es la línea de
    # base que todas las máquinas de 64 bits implementan.
    #
    # CARGO_ENCODED_RUSTFLAGS le gana a RUSTFLAGS en la precedencia de cargo, así
    # que tiene que irse o poner RUSTFLAGS acá se ignoraría en silencio.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    # `-- --locked` le pasa la bandera a cargo, que es el runner de `tauri
    # build`. Sin ella, un candado desfasado se resuelve solo y en silencio en
    # vez de cortar la compilación: dos builds del mismo commit pueden dar
    # binarios distintos y nada lo dice.
    bun run tauri build -- --locked
}

package() {
    # El directorio del bundle lleva la versión de tauri.conf.json, no la de este
    # archivo. Cuando las dos se separan, la copia falla con `cp: cannot stat`
    # nombrando una ruta en lugar del problema — y una compilación que llegó
    # hasta acá ya gastó varios minutos.
    local built
    built=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$srcdir/$pkgname/src-tauri/tauri.conf.json" | head -1)
    if [ -n "$built" ] && [ "$built" != "$pkgver" ]; then
        error "pkgver=$pkgver pero la aplicación se construyó como $built."
        error "Actualizá pkgver en este PKGBUILD para que coincida."
        return 1
    fi

    cp -a "$srcdir/$pkgname/src-tauri/target/release/bundle/deb/${pkgname}_${pkgver}_"*/data/* "${pkgdir}"

    # El plugin de i18n resuelve los catálogos en tiempo de ejecución y sólo prueba
    # rutas relativas al ejecutable y al directorio de trabajo, así que un paquete
    # instalado no encuentra nada si no van donde lib.rs los busca.
    install -dm755 "${pkgdir}/usr/share/${pkgname}/locales"
    install -Dm644 "$srcdir/$pkgname/src-tauri/locales/"*.yml \
        "${pkgdir}/usr/share/${pkgname}/locales/"
}
