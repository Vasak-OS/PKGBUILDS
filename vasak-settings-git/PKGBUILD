# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-settings
pkgver=0.2.0
pkgrel=1
pkgdesc="Settings for VasakOS"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPLv3')
depends=(
    'cairo'
    'desktop-file-utils'
    'gdk-pixbuf2'
    'glib2'
    'gtk3'
    'hicolor-icon-theme'
    'libsoup3'
    'pango'
    'webkit2gtk-4.1'
    'dbus'
)
makedepends=(
    'git'
    'openssl'
    'appmenu-gtk-module'
    'libappindicator-gtk3'
    'librsvg'
    'cargo'
    'bun'
    'rust'
)
source=("git+${url}.git")
sha256sums=('SKIP')
install="vasak-settings.install"

# makepkg's global LTO injects -flto into CFLAGS/LDFLAGS. Crates that build C or
# assembly (ring, via rustls) then emit LTO bitcode that rustc's linker cannot
# resolve, failing with undefined ring_core_* symbols. Rust does its own LTO via
# the Cargo release profile, so makepkg's is redundant here as well as harmful.
options=('!lto')

prepare() {
    cd "$srcdir/$pkgname"
    # Instalar dependencias con bun
    bun install
}

build() {
    cd "$srcdir/$pkgname"
  unset CFLAGS
  unset CXXFLAGS
  unset CPPFLAGS
  unset LDFLAGS
  unset RUSTFLAGS
  unset CARGO_BUILD_RUSTFLAGS
  export RUSTFLAGS="-C target-cpu=x86-64 -C target-feature=-sse4a,-avx,-avx2"
  export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"
    # Construir el proyecto
    bun run tauri build
}

package() {
    cp -a $srcdir/$pkgname/src-tauri/target/release/bundle/deb/${pkgname}_${pkgver}_*/data/* "${pkgdir}"

    # The i18n plugin resolves translations at runtime and only probes paths
    # relative to the binary and the working directory, so an installed build
    # finds nothing unless the locales are shipped where lib.rs looks for them.
    install -dm755 "${pkgdir}/usr/share/${pkgname}/locales"
    install -Dm644 "$srcdir/$pkgname/src-tauri/locales/"*.yml \
        "${pkgdir}/usr/share/${pkgname}/locales/"
}
