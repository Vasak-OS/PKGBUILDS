# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-wireplumber-modules
pkgver=0.1.0
pkgrel=1
pkgdesc="Módulos de WirePlumber de VasakOS"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPL3')
# ── El módulo viaja apagado ─────────────────────────────────────────────────
#
# Instalar este paquete **no cambia nada** todavía: el fragmento que declara el
# componente lo deja `disabled` en el perfil. El porqué está escrito entero en
# el propio fragmento, y el resumen es que falta la otra mitad de la regla del
# escritorio —todo lo que se bloquea se tiene que poder desbloquear—: una
# aplicación que nunca preguntó no figura en Privacidad y seguridad, así que no
# habría interruptor que mover.
#
# Se empaqueta igual porque instalado es como se prueba en un equipo de verdad,
# y porque encenderlo pasa a ser una línea en /etc en vez de una compilación.
#
# ── La ABI ──────────────────────────────────────────────────────────────────
#
# WirePlumber busca sus módulos en `/usr/lib/wireplumber-<API>`, y el directorio
# lleva la versión adentro: un WirePlumber 0.6 ni siquiera miraría donde esto se
# instala. Eso es más prolijo que el caso de Wayfire —donde la ABI es una fecha
# dentro de un encabezado— pero el modo de fallar es el mismo y es callado: el
# módulo queda en el disco, nadie lo carga, y nada lo dice.
#
# Por eso la cota es a la serie y no sólo un piso.
#
# ── Dos paquetes de WirePlumber, y hacen falta los dos ──────────────────────
#
# Auditado con `readelf -d`, no con `ldd`:
#
#   libwireplumber-0.5.so.0  →  libwireplumber   (lo que se enlaza)
#   libgio/libgobject/libglib →  glib2
#   libc.so.6                →  glibc
#
# Y aparte `wireplumber`, que es **quien posee `/usr/lib/wireplumber-0.5/`** —
# el directorio donde esto se instala— y el proceso dentro del cual el módulo
# vive. Sin el demonio el módulo no tiene dónde cargarse, y sin la biblioteca
# no resuelve sus símbolos: son dos cosas distintas y por eso están las dos.
depends=(
    'wireplumber>=0.5.0'
    'wireplumber<0.6.0'
    'libwireplumber>=0.5.0'
    'libwireplumber<0.6.0'
    'glib2'
    'glibc'
    # A quién le pregunta. Sin el servicio el módulo no puede consultar nada y
    # —porque falla cerrando— nadie tendría cámara. La versión es la que trae
    # `QueryPermissionFor`: contra una anterior la llamada se responde con
    # «Unknown method» y el módulo niega a todo el mundo.
    'vasak-permissions>=0.12.0'
)
makedepends=('git' 'meson' 'ninja' 'pkgconf')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    # La versión del proyecto más la cuenta de commits: dos commits seguidos
    # sin tocar `meson.build` tienen que dar versiones distintas o pacman no
    # ve que hay algo nuevo.
    local base
    base=$(sed -n "s/.*version:[[:space:]]*'\([^']*\)'.*/\1/p" meson.build | head -1)
    printf '%s.r%s.g%s' "${base:-0.0.0}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$pkgname"
    # `--wrap-mode=nodownload`: si faltara una dependencia, que falle acá y lo
    # diga, en vez de bajarla de internet a mitad de la compilación.
    arch-meson build --wrap-mode=nodownload
    meson compile -C build
}

check() {
    cd "$srcdir/$pkgname"
    # Las pruebas no necesitan WirePlumber andando ni una sesión: lo que decide
    # algo vive aparte del enganche justamente para poder correrlas acá. Entre
    # ellas está la que comprueba que el módulo viaje apagado.
    meson test -C build --print-errorlogs
}

package() {
    cd "$srcdir/$pkgname"
    meson install -C build --destdir "$pkgdir"
}
