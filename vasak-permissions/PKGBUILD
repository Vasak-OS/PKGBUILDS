# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>
pkgname=vasak-permissions
pkgver=0.2.0
pkgrel=1
pkgdesc="System permission service for VasakOS: camera, microphone, screen and online accounts"
arch=('x86_64')
url="https://github.com/Vasak-OS/vasak-permissions"
license=('MIT')
# polkit guards every change made from Settings; without it the management
# calls are refused and the switches cannot be moved.
depends=('webkit2gtk-4.1' 'gtk3' 'dbus' 'polkit' 'xdg-desktop-portal')
makedepends=('git' 'cargo' 'bun' 'rust')
source=("git+${url}.git")
sha256sums=('SKIP')
install="vasak-permissions.install"

# makepkg's global LTO injects -flto into CFLAGS/LDFLAGS, which breaks crates
# that build C or assembly. Cargo does its own LTO in the release profile, so
# makepkg's is redundant here as well as harmful.
options=('!lto')

build() {
    cd "$srcdir/$pkgname"
    # A package is not built for the machine that happens to compile it.
    #
    # makepkg exports RUSTFLAGS from makepkg.conf, and on this build host
    # /etc/makepkg.conf.d/rust.conf sets `-C target-cpu=native`. That compiles
    # for whatever CPU is doing the build: the result works there and dies with
    # SIGILL everywhere older. Built on any Haswell-or-newer machine it emits
    # AVX2 and BMI2 instructions, which no x86-64 from before 2013 has.
    #
    # `x86-64` is the baseline every 64-bit machine implements. Nothing else is
    # given up: opt-level, LTO and codegen-units do not depend on the CPU model
    # and stay exactly as the project's Cargo.toml sets them.
    #
    # CARGO_ENCODED_RUSTFLAGS outranks RUSTFLAGS in cargo's precedence, so it
    # has to go or setting RUSTFLAGS here would be silently ignored.
    unset CARGO_ENCODED_RUSTFLAGS
    export RUSTFLAGS="-C opt-level=3 -C target-cpu=x86-64"
    export CARGO_BUILD_RUSTFLAGS="$RUSTFLAGS"

    # The service is plain Rust: building it on its own keeps the JS toolchain
    # out of the way, and it is the piece that has to work even if the graphical
    # half fails to build.
    cargo build --release --locked -p vasak-permissions-daemon

    bun install
    bun run tauri build
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm755 "target/release/vasak-permissions" \
        "$pkgdir/usr/bin/vasak-permissions"
    # The service only accepts this exact path as the dialog agent, which is
    # what stops a program the user can write from registering itself and
    # approving its own requests. Installing it anywhere else breaks that.
    install -Dm755 "target/release/vasak-permissions-agent" \
        "$pkgdir/usr/bin/vasak-permissions-agent"

    install -Dm644 "packaging/ar.net.vasak.os.Permissions.conf" \
        "$pkgdir/usr/share/dbus-1/system.d/ar.net.vasak.os.Permissions.conf"
    install -Dm644 "packaging/ar.net.vasak.os.permissions.policy" \
        "$pkgdir/usr/share/polkit-1/actions/ar.net.vasak.os.permissions.policy"

    install -Dm644 "packaging/vasak-permissions.service" \
        "$pkgdir/usr/lib/systemd/system/vasak-permissions.service"
    install -Dm644 "packaging/vasak-permissions-agent.service" \
        "$pkgdir/usr/lib/systemd/user/vasak-permissions-agent.service"

    # The agent also serves the desktop portal's permission dialog, so those
    # prompts look like the rest of VasakOS. The .portal file is how the portal
    # finds it; without it the file is never read and GTK's dialog is used.
    install -Dm644 "packaging/vasak.portal" \
        "$pkgdir/usr/share/xdg-desktop-portal/portals/vasak.portal"
    install -Dm644 "packaging/org.freedesktop.impl.portal.desktop.vasak.service" \
        "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.vasak.service"

    # El plugin de idiomas resuelve los catálogos en tiempo de ejecución y sólo
    # prueba rutas relativas al ejecutable, así que un paquete instalado no
    # encuentra nada si no van donde `locales.rs` los busca. Sin esto, el
    # diálogo que decide si una aplicación puede usar la cámara sale con las
    # claves crudas.
    install -dm755 "$pkgdir/usr/share/vasak-permissions/locales"
    install -Dm644 "src-tauri/locales/"*.yml \
        "$pkgdir/usr/share/vasak-permissions/locales/"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
