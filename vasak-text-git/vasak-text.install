post_install() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
  # Es lo que hace que el `MimeType` del .desktop sirva de algo: la asociación
  # entre un tipo MIME y las aplicaciones que lo abren está en la caché que
  # construye este programa. Sin correrlo, «abrir con» sobre un .txt sigue sin
  # encontrar el editor hasta que otra cosa refresque la caché.
  update-desktop-database -q
}
post_upgrade() {
  post_install
}
post_remove() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
  update-desktop-database -q
}
