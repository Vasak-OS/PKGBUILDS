# Con qué se reconoce lo que agregamos a parser.conf, que es de otro paquete.
VSK_MARCA_CACHE='# VasakOS: caché de política compilada de AppArmor'

post_install() {
    # Idle lock runs under systemd, not wayfire autostart.
    mkdir -p /etc/systemd/user/graphical-session.target.wants
    ln -sf /usr/lib/systemd/user/vasak-idle.service \
        /etc/systemd/user/graphical-session.target.wants/vasak-idle.service

    # Carga el perfil de AppArmor del llavero. Se enlaza a mano y no con
    # `systemctl enable` porque esto corre dentro del chroot del instalador,
    # donde systemd no está atendiendo. La unidad lleva
    # ConditionSecurity=apparmor, así que se saltea si AppArmor no está activo.
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sf /usr/lib/systemd/system/vasak-apparmor.service \
        /etc/systemd/system/multi-user.target.wants/vasak-apparmor.service

    # Y la unidad de AppArmor de upstream, que es la que carga todo lo que hay
    # en /etc/apparmor.d.
    #
    # Sin esto, los perfiles que el hook de apparmor.d instala ahí —unos 581 en
    # un escritorio— se quedan en el disco sin que nadie los cargue nunca: el
    # equipo tiene los archivos, `aa-status` no muestra ninguno, y parece que
    # AppArmor está funcionando. Un sistema que aparenta confinar y no confina
    # es peor que uno que no lo intenta, porque nadie va a revisarlo.
    #
    # La nuestra sigue existiendo aparte: carga los perfiles de VasakOS antes
    # de sysinit.target, o sea antes de que arranque nada que confinar.
    if [ -f /usr/lib/systemd/system/apparmor.service ]; then
        ln -sf /usr/lib/systemd/system/apparmor.service \
            /etc/systemd/system/multi-user.target.wants/apparmor.service
    fi

    # Que apparmor_parser guarde en disco la política ya compilada.
    #
    # Sin esto cada arranque la recompila desde el texto, y en un equipo real
    # eso son 23 de los 33 segundos de userspace. No es tiempo en paralelo:
    # apparmor.service declara Before=sysinit.target, así que todo lo demás
    # espera a que termine. Compilar los 699 perfiles cuesta 27,7 s; leerlos de
    # la caché, 0,41 s.
    #
    # Se paga con unos 41 MB en /var/cache/apparmor, y con nada de tiempo al
    # arrancar: la caché se rehace sola cuando cambia un perfil o cuando
    # cambian las capacidades de AppArmor del kernel, y el hook de apparmor.d
    # corre el parser al final de cada transacción, así que queda hecha al
    # instalar o actualizar.
    #
    # Efecto que conviene conocer: con esto puesto, `apparmor_parser` sin
    # privilegios sale con código 1 porque no puede escribir en
    # /var/cache/apparmor. El directorio es de root y tiene que serlo —una
    # caché de política que un usuario pueda escribir es política que root
    # carga al arrancar—. Quien quiera comprobar la sintaxis de un perfil como
    # usuario tiene que pasarle `--cache-loc` a un directorio suyo. Los
    # llamadores del sistema (la unidad de arranque, el hook de apparmor.d, el
    # daemon de permisos) corren como root y no lo notan.
    #
    # Se agrega la línea en vez de instalar el archivo entero porque
    # parser.conf es del paquete apparmor y dos paquetes no pueden tener el
    # mismo archivo. Pacman lo trata como backup, así que este agregado
    # sobrevive a las actualizaciones de apparmor.
    if [ -f /etc/apparmor/parser.conf ] && \
       ! grep -qE '^[[:space:]]*write-cache[[:space:]]*$' /etc/apparmor/parser.conf; then
        # Sin línea en blanco delante: son exactamente las dos líneas que
        # post_remove borra, así que el archivo vuelve a quedar como estaba.
        printf '%s\nwrite-cache\n' "$VSK_MARCA_CACHE" >> /etc/apparmor/parser.conf
    fi

    # La configuración de PipeWire se genera a partir de la de upstream. El
    # hook de pacman la rehace cuando PipeWire se actualiza; acá se hace la
    # primera vez, al instalarnos a nosotros.
    #
    # Si falla no se aborta: el generador se aparta solo y PipeWire sigue con
    # su propia configuración, sin el socket adicional.
    /usr/lib/vasak/generar-pipewire-conf || \
        echo "  (aviso: no se pudo generar /etc/pipewire/pipewire.conf)"

    # El socket adicional lo crea systemd, y en una sesión ya iniciada no
    # aparece hasta que se reinicia la unidad. Un daemon-reload no alcanza.
    # No se puede hacer desde acá —esto corre como root y es una unidad de
    # usuario—, así que se avisa.
    echo "  Para que el socket privilegiado de PipeWire aparezca en la sesión actual:"
    echo "    systemctl --user daemon-reload && systemctl --user restart pipewire.socket pipewire.service"
    echo "  (en el próximo arranque no hace falta)"
}
post_upgrade() {
    post_install
}
post_remove() {
    rm -f /etc/systemd/user/graphical-session.target.wants/vasak-idle.service
    rm -f /etc/systemd/system/multi-user.target.wants/vasak-apparmor.service
    rm -f /etc/systemd/system/multi-user.target.wants/apparmor.service
    # Lo que le agregamos a parser.conf, que es de apparmor: se saca la marca
    # y la línea que la sigue, y sólo si la marca está.
    if [ -f /etc/apparmor/parser.conf ]; then
        sed -i "\\|^$VSK_MARCA_CACHE\$|,+1d" /etc/apparmor/parser.conf
    fi

    # Sólo si lo generamos nosotros: si alguien puso el suyo, no es nuestro.
    if [ -f /etc/pipewire/pipewire.conf ] && \
       head -1 /etc/pipewire/pipewire.conf | grep -qF "ARCHIVO GENERADO"; then
        rm -f /etc/pipewire/pipewire.conf
    fi
}
