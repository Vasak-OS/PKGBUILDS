# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-desktop-settings
pkgver=0.5.26
pkgrel=20
pkgdesc="Tools and Settings for Vasak desktop"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPLv3')
makedepends=('git')
depends=(
    # vasak-session execs uwsm; without it the session dies before the
    # compositor starts and the user is dropped straight back to the greeter.
    'uwsm'
    'wayfire'
    # El wayfire.ini de este paquete lo enciende en `plugins`. Sin el paquete,
    # Wayfire anota que no lo encuentra y sigue: el escritorio anda igual y
    # nadie anota quién pide capturar la pantalla ni leer el portapapeles, que
    # es justo la medición que hace falta antes de poder negar algo. Un aviso
    # que no sale no se distingue de uno que no hacía falta, así que va como
    # dependencia y no como sugerencia.
    'vasak-wayfire-plugins'
    # Autostarted from wayfire.ini: no shell without it, so it is not optional.
    #
    # The version floor is the menu honouring XDG precedence: before 1.3.3 it
    # read ~/.local/share/applications last and kept the first entry per file
    # name, so the uuctl override this package ships in /etc/skel would sit
    # there doing nothing.
    # 1.4.3 es la versión que trae `vasak-desktop.service`. Desde que
    # `wayfire.ini` dejó de lanzar el escritorio en su `[autostart]`, esa unidad
    # es lo único que lo arranca: con un `vasak-desktop` anterior, quien
    # actualice este paquete se queda sin escritorio.
    'vasak-desktop>=1.4.3'
    # Replaces polkit-gnome, which VasakOS no longer ships.
    'polkit-vasak-agent'
    'vasakos-icon-theme'
    'swayidle'
    # Ships /usr/bin/vasak-lock-screen, which both the idle unit and the
    # Super+L binding in wayfire.ini call: without it there is no screen lock.
    'vasak-session-manager'
    # Las fuentes que nombra la configuración que este paquete envía.
    #
    # `etc/skel/.config/vasak/vasak.conf`, los `settings.ini` de GTK, el
    # `gschema.override` y la regla de fontconfig dicen las cuatro «Noto Sans» y
    # «MesloLGL Nerd Font Mono». Estaban declaradas en el metapaquete del
    # escritorio y no acá, que es el que las nombra: instalado solo, este
    # paquete apuntaba a fuentes que podían no estar.
    #
    # Una `font-family` que no está no falla — fontconfig elige otra— así que el
    # síntoma no es un error sino un escritorio con la letra equivocada, que es
    # de las cosas que nadie reporta y todos ven.
    'noto-fonts'
    'ttf-meslo-nerd'
    # Instantáneas de btrfs antes de cada transacción de pacman. `snap-pac` trae
    # los hooks y `snapper` la rotación; sin una configuración de snapper los
    # hooks no hacen nada, así que en ext4 y xfs quedan quietos solos.
    #
    # Los dos están en `extra`, no en el AUR.
    'snapper'
    'snap-pac'
    # Pone cada instantánea en el menú de GRUB, que es lo que hace que volver
    # atrás no dependa de tener a mano un medio de instalación. `grub-btrfsd`
    # rehace el submenú cuando aparece o desaparece una, y para eso mira
    # /.snapshots con inotify — de ahí `inotify-tools`, que grub-btrfs declara
    # apenas como opcional y sin el cual el daemon arranca y no reacciona.
    #
    # Los dos están en `extra`, no en el AUR.
    'grub-btrfs'
    'inotify-tools'
    # `etc/skel/.gnupg/gpg-agent.conf` apunta a `/usr/bin/vasak-pinentry`, que
    # lo trae este paquete. Si faltara, `gpg-agent` no cae al pinentry de Arch:
    # falla el pedido de contraseña entero.
    #
    # El binario aparece en 0.7.0, que es donde entró el pinentry. Sin el mínimo,
    # una instalación con la versión anterior tendría la configuración apuntando
    # a un programa que no está, y `gpg-agent` no cae al pinentry de Arch: falla
    # el pedido entero.
    'vasak-keyring>=0.7.0'
    # Lo corre `grub-mkconfig` para poner los otros sistemas operativos en el
    # menú de arranque, que es lo que habilita el drop-in de grub.d. De `grub`
    # es apenas una dependencia opcional, así que sin declararlo acá la opción
    # queda puesta y no hay nada que ejecutar.
    'os-prober'
    # File pickers and screen sharing. The wlroots backend is the one that can
    # capture a Wayfire output.
    'xdg-desktop-portal'
    'xdg-desktop-portal-wlr'
    'cairo'
    'dbus'
    'gdk-pixbuf2'
    'glib2'
    'gtk3'
    'gtk-session-lock'
    'libsoup3'
    'pam'
    # AppArmor se enciende desde la línea de arranque (el drop-in de grub.d), y
    # vasak-apparmor.service carga el perfil del llavero con apparmor_parser.
    'apparmor'
    # El generador de /etc/pipewire/pipewire.conf valida lo que produce con
    # spa-json-dump antes de instalarlo, y ese binario viene acá.
    'pipewire'
    # 50-vasak-camara.conf es configuración de WirePlumber: sin WirePlumber el
    # archivo no lo lee nadie y la cámara queda abierta **sin que nada falle**,
    # que es la forma en que este paquete ya se equivocó antes.
    'wireplumber'
    'webkit2gtk-4.1'
)
# /etc/os-release no lo posee ningún paquete —`filesystem` trae
# /usr/lib/os-release y nada más—, así que la ruta está libre y este paquete la
# puede tomar. Declararla como backup no es porque sea configuración que alguien
# edite: es lo único que permite instalarla en un equipo donde el archivo **ya
# existe sin dueño**, que es el de cualquiera que le haya puesto VasakOS encima a
# otra distribución. Medido: sin `backup`, pacman corta la transacción entera con
# «exists in filesystem» y no instala nada; con `backup`, toma la ruta, deja el
# archivo viejo y pone el nuestro al lado como `.pacnew`. Ese `.pacnew` lo
# resuelve el `.install`, que es donde está explicado con qué regla.
backup=('etc/os-release')
optdepends=(
    # El logo de VasakOS en la terminal. `etc/fastfetch/config.jsonc` y el
    # dibujo de `usr/share/fastfetch/logos/` no hacen nada sin él, y no se
    # declara como dependencia porque un escritorio no necesita un fetch para
    # funcionar: lo instala quien lo quiere —el instalador lo ofrece— y ahí el
    # logo aparece solo.
    'fastfetch: el logo de VasakOS en la terminal'
)
source=("git+${url}.git")
sha256sums=('SKIP')
install="vasak-desktop-settings.install"

# Que los tres lugares que nombran fuentes digan lo mismo.
#
# Son tres porque los leen tres cosas distintas: `vasak.conf` lo leen las
# aplicaciones propias, los `settings.ini` los leen las aplicaciones GTK al
# arrancar, y el esquema de GSettings es lo que el portal informa a las que están
# aisladas. Nada obliga a que coincidan, y no coincidían: uno decía «Roboto 10»,
# otro «Noto Sans, 11» y el tercero «FantasqueSansM Nerd Font Propo», así que el
# escritorio se veía con una fuente distinta según qué abrieras.
#
# El chequeo va acá y no en el repositorio de origen porque ese repo son archivos
# de configuración sin nada que ejecute tests, y `makepkg` corre `check()` en
# cada compilación — que es exactamente cuando importa.
check() {
    cd "$srcdir/$pkgname"

    # La copia del kernel para las instantáneas: se ejercita contra directorios
    # temporales, sin tocar /boot ni necesitar btrfs.
    ./pruebas/arranque.sh || return 1

    # Y que lo que le escribimos a archivos de otros paquetes se pueda sacar
    # entero. Corre contra el `.install` de este mismo directorio.
    VSK_INSTALL="$startdir/$install" ./pruebas/marcas-en-archivos-ajenos.sh || return 1

    # Que el ruido de AppArmor siga fuera del diario: que la lista de perfiles
    # ignorados esté, que el tope del diario le gane al de cachyos-settings, y
    # —lo que más importa— que este PKGBUILD los instale. Corre contra sí mismo.
    VSK_PKGBUILD="$startdir/PKGBUILD" ./pruebas/apparmor-ruido-fuera-del-diario.sh || return 1

    # Que el sistema sepa decir quién es: que os-release esté bien escrito, que
    # la versión sea la misma en los dos lugares que la dicen, que **este**
    # PKGBUILD los instale, y que la toma de /etc/os-release resuelva su
    # `.pacnew` en un equipo que venía de otra distribución.
    VSK_PKGBUILD="$startdir/PKGBUILD" VSK_INSTALL="$startdir/$install" \
        ./pruebas/identidad-del-sistema.sh || return 1

    local vasak_apps gtk3 gtk4 esquema
    # La familia de `apps` en vasak.conf, sin comillas.
    vasak_apps=$(sed -n 's/.*"apps"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        etc/skel/.config/vasak/vasak.conf)
    # La de GTK viene con el tamaño pegado: se le saca el número final.
    gtk3=$(sed -n 's/^gtk-font-name=\(.*[^0-9]\)[[:space:]]*[0-9]*$/\1/p' \
        etc/skel/.config/gtk-3.0/settings.ini | sed 's/[[:space:]]*$//')
    gtk4=$(sed -n 's/^gtk-font-name=\(.*[^0-9]\)[[:space:]]*[0-9]*$/\1/p' \
        etc/skel/.config/gtk-4.0/settings.ini | sed 's/[[:space:]]*$//')
    esquema=$(sed -n "s/^font-name='\(.*[^0-9]\)[[:space:]]*[0-9]*'$/\1/p" \
        schemas/99_vasakos-settings.gschema.override | sed 's/[[:space:]]*$//')

    if [[ -z $vasak_apps || -z $gtk3 || -z $gtk4 || -z $esquema ]]; then
        echo "check: no se pudo leer alguna de las cuatro fuentes" >&2
        echo "  vasak.conf=[$vasak_apps] gtk3=[$gtk3] gtk4=[$gtk4] esquema=[$esquema]" >&2
        return 1
    fi

    if [[ $vasak_apps != "$gtk3" || $vasak_apps != "$gtk4" || $vasak_apps != "$esquema" ]]; then
        echo "check: las fuentes de las aplicaciones no coinciden entre sí" >&2
        echo "  vasak.conf        $vasak_apps" >&2
        echo "  gtk-3.0           $gtk3" >&2
        echo "  gtk-4.0           $gtk4" >&2
        echo "  gschema.override  $esquema" >&2
        return 1
    fi

    # La monoespaciada, entre la terminal y lo que se le informa a GTK.
    local vasak_term esquema_mono
    vasak_term=$(sed -n 's/.*"terminal"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        etc/skel/.config/vasak/vasak.conf)
    esquema_mono=$(sed -n "s/^monospace-font-name='\(.*[^0-9]\)[[:space:]]*[0-9]*'$/\1/p" \
        schemas/99_vasakos-settings.gschema.override | sed 's/[[:space:]]*$//')

    if [[ $vasak_term != "$esquema_mono" ]]; then
        echo "check: la monoespaciada no coincide" >&2
        echo "  vasak.conf        $vasak_term" >&2
        echo "  gschema.override  $esquema_mono" >&2
        return 1
    fi

    # Y que existan, no sólo que coincidan.
    #
    # Los cuatro archivos pueden estar de acuerdo en una fuente que no instala
    # nadie, y eso no falla en ningún lado: fontconfig elige otra y el
    # escritorio se ve con la letra equivocada. En un chroot limpio lo único que
    # hay instalado son las dependencias declaradas, así que esto comprueba de
    # punta a punta que `depends` cubra lo que la configuración pide.
    if command -v fc-list >/dev/null; then
        local familia
        for familia in "$vasak_apps" "$vasak_term"; do
            if ! fc-list : family | tr ',' '\n' | grep -qxF "$familia"; then
                echo "check: la configuración pide «$familia» y no hay quien la instale" >&2
                echo "  agregala a depends() con el paquete que la provee" >&2
                return 1
            fi
        done
    else
        echo "check: sin fontconfig, no se puede comprobar que las fuentes existan" >&2
    fi

    echo "check: las fuentes coinciden y están — $vasak_apps / $vasak_term"
}

package() {
    cd "$srcdir/$pkgname"
    install -dm755 $pkgdir/etc
    install -dm755 $pkgdir/usr/share/glib-2.0/schemas
    install -dm755 $pkgdir/etc/skel
    cp -r $srcdir/$pkgname/etc/skel $pkgdir/etc/

    # `~/.gnupg` con 0700, que es lo que gpg exige.
    #
    # git no guarda el modo de un directorio, así que el `cp -r etc/skel` de
    # arriba lo deja en 0755 y gpg arranca quejándose de permisos inseguros en
    # cada operación. Se corrige acá, que es donde el modo existe.
    install -dm700 "$pkgdir/etc/skel/.gnupg"
    install -Dm600 "$srcdir/$pkgname/etc/skel/.gnupg/gpg-agent.conf" \
        "$pkgdir/etc/skel/.gnupg/gpg-agent.conf"

    # Lets pinentry find the graphical dialog even when gpg-agent was started
    # without the session environment.
    install -Dm755 "$srcdir/$pkgname/etc/pinentry/preexec" \
        "$pkgdir/etc/pinentry/preexec"
    # El drop-in de GRUB. Iba en el repo desde hace
    # rato y el paquete no los instalaba: el `package()` sólo copiaba `etc/skel`
    # y `etc/pinentry`, así que el `GRUB_DISTRIBUTOR="VasakOS"` nunca llegó a un
    # sistema instalado —el plugin del instalador venía avisando «el menú de
    # arranque va a decir Arch» en cada instalación—.
    #
    # Se instalan uno por uno y no con un `cp -r etc/` porque `etc/skel` necesita
    # su propio trato más arriba —los modos que git no guarda— y porque así se ve
    # archivo por archivo qué llega al equipo y qué no.
    install -Dm644 "$srcdir/$pkgname/etc/default/grub.d/10-vasakos.cfg" \
        "$pkgdir/etc/default/grub.d/10-vasakos.cfg"

    # Quién es este sistema.
    #
    # El archivo estaba escrito en el repositorio y no se instalaba, así que un
    # VasakOS instalado decía «Arch Linux» en `fastfetch`, en los reportes de bugs
    # y en el nombre que los navegadores informan. No se arreglaba solo desde la
    # ISO: el destino se arma con `pacstrap`, no copiando el squashfs del medio
    # live, así que lo único que llegaba era el os-release de `filesystem`.
    #
    # Acá estuvo además el comentario que impidió arreglarlo antes: decía que
    # /etc/os-release lo poseía `filesystem` y que copiarlo haría fallar el
    # pacstrap. `pacman -Ql filesystem` lista /usr/lib/os-release y ninguno más.
    install -Dm644 "$srcdir/$pkgname/etc/os-release" "$pkgdir/etc/os-release"

    # Y la versión de la publicación, que es el archivo que los documentos de
    # reporte de bugs le piden a la gente que muestre. Existe en el repositorio
    # desde 2023 y tampoco se instalaba: `cat /etc/vasakos/vasakos-release`
    # contestaba «No existe el fichero o el directorio» en todos los equipos.
    install -Dm644 "$srcdir/$pkgname/etc/vasakos/vasakos-release" \
        "$pkgdir/etc/vasakos/vasakos-release"

    # Y el logo, que es la misma identidad en la terminal. El dibujo viaja con
    # el `cp -r usr` de más abajo; esto es la configuración que le dice a
    # fastfetch que lo use, porque sus logos van compilados adentro del binario
    # y `LOGO=vasakos` de os-release no alcanza para que aparezca uno nuevo.
    install -Dm644 "$srcdir/$pkgname/etc/fastfetch/config.jsonc" \
        "$pkgdir/etc/fastfetch/config.jsonc"

    # Los perfiles de AppArmor que sí se instalan.
    #
    # Son los de los procesos que **no** levantan una ventana Tauri: los otros
    # que se escribieron tumbaban el escritorio —casi mil volcados de WebKit en
    # un arranque— y quedaron en apparmor-borrador/, sin empaquetarse.
    #
    # `vasak-accounts` entra por eso mismo: es un demonio de root sin interfaz,
    # así que esa clase de caída no le aplica. Va en complain, como el del
    # llavero.
    for perfil in vasak-keyring vasak-appimage vasak-accounts; do
        install -Dm644 "$srcdir/$pkgname/etc/apparmor.d/$perfil" \
            "$pkgdir/etc/apparmor.d/$perfil"
    done

    # Qué perfiles del sistema hacen cumplir y no sólo avisan. Lo lee
    # `aa-install`, que trae apparmor.d-tools, y le gana al `--complain` del hook
    # de pacman para los perfiles que nombra.
    install -Dm644 "$srcdir/$pkgname/etc/apparmor/flags.d/50-vasakos.conf" \
        "$pkgdir/etc/apparmor/flags.d/50-vasakos.conf"

    # Los perfiles que no se instalan porque sólo hacen ruido. Cuatro de ellos
    # —git, dockerd, containerd/runc y gitstatusd— eran el 80% del diario
    # anotando cosas que se permitieron, y con eso no entraba ni un arranque.
    install -Dm644 "$srcdir/$pkgname/etc/apparmor/ignore.d/50-vasakos-ruido.conf" \
        "$pkgdir/etc/apparmor/ignore.d/50-vasakos-ruido.conf"

    # La prioridad de tiempo real del audio. Sin esto los hilos de datos de
    # PipeWire corren en SCHED_OTHER y el audio chasquea bajo carga — no falla
    # y no avisa. Venía de `cachyos-settings`, que no lo exige nadie y no entra
    # en una instalación limpia de VasakOS.
    install -Dm644 "$srcdir/$pkgname/etc/security/limits.d/50-vasak-audio.conf" \
        "$pkgdir/etc/security/limits.d/50-vasak-audio.conf"

    # Sin cupo de printk, para que una denegación no se pierda camino al
    # servicio de permisos: lo mide el propio archivo.
    install -Dm644 "$srcdir/$pkgname/etc/sysctl.d/50-vasakos-auditoria.conf" \
        "$pkgdir/etc/sysctl.d/50-vasakos-auditoria.conf"

    # Y el tope del diario, que de fábrica son 50 MB heredados de
    # `cachyos-settings`: poco para un sistema que corre 1592 perfiles en modo
    # aviso y además apaga el cupo de printk a propósito.
    install -Dm644 "$srcdir/$pkgname/etc/systemd/journald.conf.d/50-vasakos-diario.conf" \
        "$pkgdir/etc/systemd/journald.conf.d/50-vasakos-diario.conf"
    cp -r $srcdir/$pkgname/usr $pkgdir/

    # La regla de fontconfig se instala en `conf.avail` y se activa con un enlace
    # en `conf.d`, que es el mecanismo que documenta fontconfig y el que usan sus
    # propias reglas. Dejarla sólo en `conf.avail` la deja escrita y sin efecto;
    # ponerla sólo en `conf.d` la vuelve imposible de desactivar sin borrar un
    # archivo del paquete.
    install -dm755 "$pkgdir/etc/fonts/conf.d"
    ln -sf /usr/share/fontconfig/conf.avail/60-vasakos.conf \
        "$pkgdir/etc/fonts/conf.d/60-vasakos.conf"

    chmod a+x $pkgdir/usr/bin/vasak-session
    chmod a+x $pkgdir/usr/lib/vasak/generar-pipewire-conf
    chmod a+x $pkgdir/usr/lib/vasak/copiar-arranque
    chmod a+x $pkgdir/usr/lib/vasak/descargar-perfiles-ignorados
    chmod a+x $pkgdir/usr/lib/vasak/restaurar-arranque
    chmod a+x $pkgdir/usr/lib/vasak/boot-state
    chmod a+x $pkgdir/usr/lib/vasak/boot-notice
    cp $srcdir/$pkgname/schemas/* $pkgdir/usr/share/glib-2.0/schemas
}
