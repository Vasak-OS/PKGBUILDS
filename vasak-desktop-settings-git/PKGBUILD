# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>

pkgname=vasak-desktop-settings
pkgver=0.2.0
pkgrel=1
pkgdesc="Tools and Settings for Vasak desktop"
arch=('x86_64')
url="https://github.com/Vasak-OS/$pkgname"
license=('GPLv3')
makedepends=('git')
depends=(
    'polkit-gnome'
    'wayfire'
    'vasakos-icon-theme'
    'swayidle'
    'gtklock'
)
source=("git+${url}.git")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname"
    install -dm755 $pkgdir/etc
    install -dm755 $pkgdir/usr/share/glib-2.0/schemas
    install -dm755 $pkgdir/etc/skel
    cp -r $srcdir/$pkgname/etc/skel $pkgdir/etc/
    cp -r $srcdir/$pkgname/usr $pkgdir/
    chmod a+x $pkgdir/usr/bin/vasak-session
    cp $srcdir/$pkgname/schemas/* $pkgdir/usr/share/glib-2.0/schemas
}

post_install() {
    # Idle lock runs under systemd, not wayfire autostart.
    mkdir -p /etc/systemd/user/graphical-session.target.wants
    ln -sf /usr/lib/systemd/user/vasak-idle.service \
        /etc/systemd/user/graphical-session.target.wants/vasak-idle.service
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /etc/systemd/user/graphical-session.target.wants/vasak-idle.service
}
