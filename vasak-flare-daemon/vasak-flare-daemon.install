post_install() {
    # Graphical-session user service (started by uwsm with the session).
    mkdir -p /etc/systemd/user/graphical-session.target.wants
    ln -sf /usr/lib/systemd/user/vasak-flare-daemon.service \
        /etc/systemd/user/graphical-session.target.wants/vasak-flare-daemon.service
}
post_upgrade() {
    post_install
}
post_remove() {
    rm -f /etc/systemd/user/graphical-session.target.wants/vasak-flare-daemon.service
}
