# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>
pkgname=vasak-flare-daemon
pkgver=0.1.0
pkgrel=1
pkgdesc="Persistent freedesktop notification daemon for VasakOS (Tauri + Vue)"
arch=('x86_64')
url="https://github.com/Vasak-OS/vasak-flare-daemon"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'gtk-layer-shell' 'dbus' 'sqlite')
makedepends=('git' 'cargo' 'bun' 'rust')
source=("git+${url}.git")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname"
    bun install
    bun run tauri build
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm755 "src-tauri/target/release/$pkgname" \
        "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "packaging/$pkgname.service" \
        "$pkgdir/usr/lib/systemd/user/$pkgname.service"
}

post_install() {
    # Graphical-session user service (started by uwsm with the session).
    mkdir -p /etc/systemd/user/graphical-session.target.wants
    ln -sf /usr/lib/systemd/user/vasak-flare-daemon.service \
        /etc/systemd/user/graphical-session.target.wants/vasak-flare-daemon.service
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /etc/systemd/user/graphical-session.target.wants/vasak-flare-daemon.service
}
