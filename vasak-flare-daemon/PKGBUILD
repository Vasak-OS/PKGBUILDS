# Maintainer: VasakOS
pkgname=vasak-flare-daemon
pkgver=0.1.0
pkgrel=1
pkgdesc="Persistent freedesktop notification daemon for VasakOS"
arch=('x86_64')
license=('MIT')
depends=('dbus' 'sqlite')
makedepends=('cargo' 'rust')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --release --locked
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "target/release/vasak-flare-daemon" "${pkgdir}/usr/bin/vasak-flare-daemon"
  install -Dm644 "systemd/user/vasak-flare-daemon.service" "${pkgdir}/usr/lib/systemd/user/vasak-flare-daemon.service"
}
