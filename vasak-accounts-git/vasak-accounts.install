post_install() {
    systemctl daemon-reload 2>/dev/null || true
    # D-Bus activated, so it does not need enabling: the first request starts it.
    # Reloading the bus configuration is what makes that possible right away
    # instead of only after the next boot.
    systemctl reload dbus.service 2>/dev/null || true
}

post_upgrade() {
    systemctl daemon-reload 2>/dev/null || true
    systemctl reload dbus.service 2>/dev/null || true
    systemctl try-restart vasak-accounts.service 2>/dev/null || true
}

pre_remove() {
    systemctl stop vasak-accounts.service 2>/dev/null || true
}

post_remove() {
    systemctl daemon-reload 2>/dev/null || true
    echo "Las cuentas y sus tokens quedan en /var/lib/vasak-accounts."
}
