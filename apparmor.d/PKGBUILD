# Maintainer: Joaquin (Pato) Decima <jdecima@vasak.net.ar>
# Basado en el PKGBUILD del propio autor del proyecto (Alexandre Pujol), que se
# publica en AUR. Se empaqueta en el repositorio de VasakOS en vez de tomarlo de
# AUR porque instalar desde AUR en la máquina de quien usa el sistema es
# justamente lo que la política de la distribución evita.

pkgbase=apparmor.d
pkgname=(
  apparmor.d
  apparmor.d-base
  apparmor.d-tools
)
pkgver=0.4912.0
pkgrel=1
pkgdesc="Perfiles de AppArmor para el sistema completo (inertes hasta activarlos)"
arch=('x86_64')
url="https://github.com/roddhjav/apparmor.d"
license=('GPL-2.0-only')
depends=('apparmor>=4.1.3' 'apparmor<5.0.0')
makedepends=('go' 'git' 'just')
source=("https://github.com/roddhjav/$pkgbase/releases/download/v$pkgver/$pkgbase-$pkgver.tar.gz")
# Comprobada a mano contra el tarball publicado, no copiada del PKGBUILD ajeno.
sha512sums=('f142dea0edb760f3c6155ffdc096233a23da1d176f2b028dfbe17c81652a9be5396da639b55db33c3e67b3901147d76026a67ed491fcc1c8e6f42b3397cd65f9')

# Sin `validpgpkeys`, como el resto de los paquetes de este repositorio.
#
# El PKGBUILD del autor verifica la firma de su release, lo que obliga a
# importar una clave ajena para poder compilar. Acá la cadena de confianza es
# otra y es la de VasakOS: el tarball queda fijado por su sha512, y el paquete
# que resulta se firma con las claves del repositorio —las que distribuye
# vasakos-keyring y con las que pacman lo verifica en la máquina de quien lo
# instala—.
#
# Lo que se pierde con esto conviene decirlo: la firma de upstream habría
# detectado un tarball reemplazado *antes* de que fijáramos su hash. Con este
# esquema, esa ventana la cubre quien actualiza el paquete comprobando el hash
# contra lo publicado, que es lo que se hizo para esta versión.

build() {
  cd "$srcdir/$pkgbase-$pkgver"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOPATH="${srcdir}"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
  export DISTRIBUTION=arch
  just prebuild

  # Los drop-ins los genera el prebuild, así que el parche va acá y no en un
  # prepare(): antes del build todavía no existen.
  sed -i 's/^AppArmorProfile=\\([^-]\\)/AppArmorProfile=-\\1/' .build/systemd/*/* 
}

# Los drop-ins de D-Bus toleran que el perfil no esté cargado.
#
# El paquete instala perfiles en /usr/share/apparmor.d —inertes— y además
# cuatro drop-ins de systemd que ponen `AppArmorProfile=dbus-system` en D-Bus.
# Esos sí tienen efecto apenas se instala, y vienen **sin** el prefijo `-`, o
# sea exigiendo que el perfil esté cargado.
#
# Como los perfiles no se cargan hasta que alguien corra `aa-install`, eso deja
# una ventana en la que D-Bus depende de algo que no existe. En una unidad de
# usuario se comprobó que no impide arrancar; en una del sistema no se pudo
# comprobar sin root, y el modo de fallo sería un equipo que no levanta.
#
# No vale la pena averiguarlo por las malas: el prefijo `-` hace que un perfil
# ausente se ignore, y no cambia nada cuando sí está cargado.
#
# Se aplica al final de build() porque los drop-ins los genera el prebuild.
# Que el build haya producido algo y que los drop-ins sean tolerantes.
#
# No se comprueba el modo de los perfiles: se elige al **activarlos**, no al
# construirlos. El paquete los deja inertes en /usr/share/apparmor.d y es
# `aa-install --complain` quien los pone en /etc/apparmor.d en modo aviso.
#
# Eso se descubrió porque un check anterior exigía complain en el build y falló
# con 1537 perfiles de 1592 — que era el check haciendo su trabajo, sólo que
# comprobando lo que no correspondía.
check() {
  cd "$srcdir/$pkgbase-$pkgver"
  local perfiles
  perfiles=$(find .build/apparmor.d -type f 2>/dev/null | wc -l)
  if [ "$perfiles" -lt 1000 ]; then
    echo "check: sólo $perfiles perfiles; el build cambió de forma" >&2
    return 1
  fi
  echo "check: $perfiles perfiles construidos"

  local sin_guion
  sin_guion=$(grep -l "^AppArmorProfile=[^-]" .build/systemd/*/* 2>/dev/null | wc -l)
  if [ "$sin_guion" -ne 0 ]; then
    echo "check: $sin_guion drop-ins exigen un perfil cargado; ver prepare()" >&2
    return 1
  fi
  echo "check: los drop-ins de systemd toleran un perfil ausente"
}

package_apparmor.d() {
  depends=('apparmor' 'apparmor.d-base' 'apparmor.d-tools')
  arch=("any")
  cd "$srcdir/$pkgbase-$pkgver"
  just destdir="$pkgdir" install-profiles
}

package_apparmor.d-base() {
  pkgdesc="$pkgdesc (abstracciones, tunables y booleanos)"
  arch=("any")
  cd "$srcdir/$pkgbase-$pkgver"
  just destdir="$pkgdir" install-base
}

package_apparmor.d-tools() {
  pkgdesc="$pkgdesc (herramientas de usuario)"
  cd "$srcdir/$pkgbase-$pkgver"
  just destdir="$pkgdir" install-tools
}
